# Copy to .env and fill in values. Never commit .env.

# --- Database ---
DATABASE_URL=postgres://notifitra:notifitra@localhost:5432/notifitra

# --- Redis / queue ---
REDIS_URL=redis://localhost:6379

# --- API ---
PORT=3000
# Used to hash/verify API keys. Generate a long random value in production.
API_KEY_SECRET=change-me

# --- Email adapter (pick one provider) ---
EMAIL_PROVIDER=resend
RESEND_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# --- Push adapter ---
NTFY_BASE_URL=http://localhost:8080

# --- Admin dashboard (Phase 0 decision #1: single admin account) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
